{% extends 'base.html.twig' %}

{% block title %}Copropriétés{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 text-primary">
                <i class="fas fa-building"></i> Liste des copropriétés
            </h1>
            <a href="{{ path('app_copropriete_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nouvelle copropriété
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Identifiant</th>
                            <th>Nom de la copropriété</th>
                            <th>Adresse</th>
                            <th>Tantièmes</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for copropriete in coproprietes %}
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark">#{{ copropriete.id }}</span>
                            </td>
                            <td>
                                <strong>{{ copropriete.nomCopropriete }}</strong>
                            </td>
                            <td>
                                <i class="fas fa-map-marker-alt text-danger"></i>
                                {{ copropriete.adresseCopropriete }}
                            </td>
                            <td>
                                <span class="badge bg-info">{{ copropriete.tantiemeCopropriete }}</span>
                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Actions">
                                    <a href="{{ path('app_copropriete_show', {'id': copropriete.id}) }}" 
                                       class="btn btn-info btn-sm"
                                       title="Voir les détails">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('app_copropriete_edit', {'id': copropriete.id}) }}" 
                                       class="btn btn-warning btn-sm"
                                       title="Modifier">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fas fa-building fa-2x mb-2"></i>
                                <br>
                                <em>Aucune copropriété trouvée</em>
                                <br>
                                <small>Commencez par créer votre première copropriété</small>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            
            {% if coproprietes is not empty %}
                <div class="card-footer text-muted">
                    <small>
                        <i class="fas fa-info-circle"></i>
                        Total : {{ coproprietes|length }} copropriété(s)
                    </small>
                </div>
            {% endif %}
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card border-primary">
                    <div class="card-body text-center">
                        <i class="fas fa-building fa-2x text-primary mb-3"></i>
                        <h5 class="card-title">Ajouter une copropriété</h5>
                        <p class="card-text">Créer une nouvelle copropriété dans le système</p>
                        <a href="{{ path('app_copropriete_new') }}" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Créer
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <i class="fas fa-users fa-2x text-success mb-3"></i>
                        <h5 class="card-title">Gestion globale</h5>
                        <p class="card-text">Gérer les copropriétaires et assemblées</p>
                        <div class="btn-group" role="group">
                            <a href="{{ path('app_coproprietaire_index') }}" class="btn btn-success btn-sm">
                                <i class="fas fa-users"></i> Copropriétaires
                            </a>
                            <a href="{{ path('app_assemblee_generale_index') }}" class="btn btn-success btn-sm">
                                <i class="fas fa-gavel"></i> Assemblées
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}