{% extends 'base.html.twig' %}

{% block title %}Copropriete{% endblock %}

{% block body %}
    <h1>Copropriété</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Identifiant</th>
                <td>{{ copropriete.id }}</td>
            </tr>
            <tr>
                <th>Nom de la Copropriété</th>
                <td>{{ copropriete.nomCopropriete }}</td>
            </tr>
            <tr>
                <th>Addresse de la copropriété</th>
                <td>{{ copropriete.adresseCopropriete }}</td>
            </tr>
            <tr>
                <th>Tantième copropriété</th>
                <td>{{ copropriete.tantiemeCopropriete }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_copropriete_index') }}">Retour à la liste</a>

    <a href="{{ path('app_copropriete_edit', {'id': copropriete.id}) }}">Editer</a>

    {{ include('copropriete/_delete_form.html.twig') }}
{% endblock %}
