{% extends 'base.html.twig' %}

{% block title %}QuestionAVoter index{% endblock %}

{% block body %}
    <h1>Liste question à voter</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Identifiant</th>
                <th>Contenu</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for question_a_voter in question_a_voters %}
            <tr>
                <td>{{ question_a_voter.id }}</td>
                <td>{{ question_a_voter.contenu }}</td>
                <td>
                    <a href="{{ path('app_question_a_voter_show', {'id': question_a_voter.id}) }}">Montrer</a>
                    <a href="{{ path('app_question_a_voter_edit', {'id': question_a_voter.id}) }}">Editer</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucune données</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_question_a_voter_new') }}">Créer une nouvelle question</a>
{% endblock %}
