{% extends 'base.html.twig' %}

{% block title %}Copropriétaires{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 text-primary">
                <i class="fas fa-users"></i> Liste des copropriétaires
            </h1>
            <a href="{{ path('app_coproprietaire_new') }}" class="btn btn-primary">
                <i class="fas fa-user-plus"></i> Nouveau copropriétaire
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Identifiant</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Domicile</th>
                            <th>Quote-Part</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for coproprietaire in coproprietaires %}
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark">#{{ coproprietaire.id }}</span>
                            </td>
                            <td>
                                <strong>{{ coproprietaire.nom }}</strong>
                            </td>
                            <td>{{ coproprietaire.prenom }}</td>
                            <td>
                                <i class="fas fa-map-marker-alt text-danger"></i>
                                {{ coproprietaire.domicile }}
                            </td>
                            <td>
                                <span class="badge bg-success">{{ coproprietaire.quotePart }}</span>
                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Actions">
                                    <a href="{{ path('app_coproprietaire_show', {'id': coproprietaire.id}) }}" 
                                       class="btn btn-info btn-sm" 
                                       title="Voir les détails">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('app_coproprietaire_edit', {'id': coproprietaire.id}) }}" 
                                       class="btn btn-warning btn-sm"
                                       title="Modifier">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-user-slash fa-2x mb-2"></i>
                                <br>
                                <em>Aucun copropriétaire trouvé</em>
                                <br>
                                <small>Commencez par créer votre premier copropriétaire</small>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            
            {% if coproprietaires is not empty %}
                <div class="card-footer text-muted">
                    <small>
                        <i class="fas fa-info-circle"></i>
                        Total : {{ coproprietaires|length }} copropriétaire(s)
                    </small>
                </div>
            {% endif %}
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card border-primary">
                    <div class="card-body text-center">
                        <i class="fas fa-user-plus fa-2x text-primary mb-3"></i>
                        <h5 class="card-title">Ajouter un copropriétaire</h5>
                        <p class="card-text">Créer un nouveau copropriétaire dans le système</p>
                        <a href="{{ path('app_coproprietaire_new') }}" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Créer
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}