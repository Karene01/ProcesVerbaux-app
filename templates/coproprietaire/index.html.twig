{% extends 'base.html.twig' %}

{% block title %}Coproprietaire index{% endblock %}

{% block body %}
    <h1>Coproprietaire index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>Domicile</th>
                <th>QuotePart</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for coproprietaire in coproprietaires %}
            <tr>
                <td>{{ coproprietaire.id }}</td>
                <td>{{ coproprietaire.nom }}</td>
                <td>{{ coproprietaire.prenom }}</td>
                <td>{{ coproprietaire.domicile }}</td>
                <td>{{ coproprietaire.quotePart }}</td>
                <td>
                    <a href="{{ path('app_coproprietaire_show', {'id': coproprietaire.id}) }}">show</a>
                    <a href="{{ path('app_coproprietaire_edit', {'id': coproprietaire.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_coproprietaire_new') }}">Create new</a>
{% endblock %}
