{% extends 'base.html.twig' %}

{% block title %}Coproprietaire{% endblock %}

{% block body %}
    <h1>Copropriétaire</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Identifiant</th>
                <td>{{ coproprietaire.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ coproprietaire.nom }}</td>
            </tr>
            <tr>
                <th>Prénom</th>
                <td>{{ coproprietaire.prenom }}</td>
            </tr>
            <tr>
                <th>Domicile</th>
                <td>{{ coproprietaire.domicile }}</td>
            </tr>
            <tr>
                <th>Quote-Part</th>
                <td>{{ coproprietaire.quotePart }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_coproprietaire_index') }}">Retour à la liste</a>

    <a href="{{ path('app_coproprietaire_edit', {'id': coproprietaire.id}) }}">Editer</a>

    {{ include('coproprietaire/_delete_form.html.twig') }}
{% endblock %}
