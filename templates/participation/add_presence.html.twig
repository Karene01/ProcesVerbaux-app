{% extends 'base.html.twig' %}

{% block title %}Ajouter une présence{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">
            <i class="fas fa-user-plus"></i> Ajouter une présence
        </h1>
        <a href="{{ path('app_assemblee_generale_show', { id: assemblee_generale.id }) }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Retour à l'assemblée
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
            
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-clipboard-list"></i> Informations de participation
                    </h5>
                </div>
                <div class="card-body">
                    {{ form_errors(form) }}

                    <div class="mb-3">
                        {{ form_label(form.participant, 'Copropriétaire', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.participant, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.participant) }}
                        <div class="form-text">Sélectionnez le copropriétaire participant</div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            {{ form_widget(form.present, {'attr': {'class': 'form-check-input'}}) }}
                            {{ form_label(form.present, 'Présent physiquement', {'label_attr': {'class': 'form-check-label fw-bold'}}) }}
                        </div>
                        <div class="form-text">Cochez si le copropriétaire est présent à l'assemblée</div>
                    </div>

                    <div class="mb-3" id="mandataire-field">
                        {{ form_label(form.mandataire, 'Mandataire (si absent)', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.mandataire, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.mandataire) }}
                        <div class="form-text">Si absent, sélectionnez qui le représente</div>
                    </div>

                    {{ form_widget(form.assembleeGenerale, {'attr': {'class': 'd-none'}}) }}
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a href="{{ path('app_assemblee_generale_show', { id: assemblee_generale.id }) }}" class="btn btn-outline-secondary">
                    <i class="fas fa-times"></i> Annuler
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-check"></i> Ajouter la participation
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const presentCheckbox = document.querySelector('#participation_present');
        const mandataireField = document.querySelector('#participation_mandataire');
        const mandataireContainer = document.querySelector('#mandataire-field');

        function toggleMandataire() {
            if (presentCheckbox.checked) {
                mandataireField.value = '';
                mandataireField.disabled = true;
                mandataireContainer.style.opacity = '0.5';
                mandataireContainer.style.pointerEvents = 'none';
            } else {
                mandataireField.disabled = false;
                mandataireContainer.style.opacity = '1';
                mandataireContainer.style.pointerEvents = 'auto';
            }
        }

        presentCheckbox.addEventListener('change', toggleMandataire);
        toggleMandataire();
    });
</script>
{% endblock %}