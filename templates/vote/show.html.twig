{% extends 'base.html.twig' %}

{% block title %}Vote{% endblock %}

{% block body %}
    <h1>Vote</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ vote.id }}</td>
            </tr>
            <tr>
                <th>Valeur du vote</th>
                <td>{{ vote.valeurVote }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_vote_index') }}">Retour à la liste</a>

    <a href="{{ path('app_vote_edit', {'id': vote.id}) }}">Modifier</a>

    {{ include('vote/_delete_form.html.twig') }}
{% endblock %}
