{% extends 'base.html.twig' %}

{% block title %}Vote index{% endblock %}

{% block body %}
    <h1>Liste des votes</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Identifiants</th>
                <th>Valeur du vote</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for vote in votes %}
            <tr>
                <td>{{ vote.id }}</td>
                <td>{{ vote.valeurVote }}</td>
                <td>
                    <a href="{{ path('app_vote_show', {'id': vote.id}) }}">Montrer</a>
                    <a href="{{ path('app_vote_edit', {'id': vote.id}) }}">Editer</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucune donnée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_vote_new') }}">Créer un nouveau vote</a>
{% endblock %}
