{% extends 'base.html.twig' %}

{% block title %}AssembleeGenerale{% endblock %}
{% block body %}

    <h1>AssembleeGenerale</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ assemblee_generale.id }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ assemblee_generale.date ? assemblee_generale.date|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Heure</th>
                <td>{{ assemblee_generale.heure ? assemblee_generale.heure|date('H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>



    {% if not assemblee_generale.ouverte %}
    <form method="post" action="{{ path('assemblee_generale_ouvrir', {'id': assemblee_generale.id}) }}" onsubmit="return confirm('Débuter cette assemblée ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('ouvrir' ~ assemblee_generale.id) }}">
        <button class="btn btn-success">Débuter l’assemblée</button>
    </form>
    {% else %}
        <form method="post" action="{{ path('assemblee_generale_clore', {'id': assemblee_generale.id}) }}" onsubmit="return confirm('Clôturer cette assemblée ?');">
            <span class="badge bg-success">Assemblée en cours</span>
            <input type="hidden" name="_token" value="{{ csrf_token('clore' ~ assemblee_generale.id) }}">
            <button class="btn btn-danger">Clôturer l’assemblée</button>
        </form>
    {% endif %}

    <h3>Copropriété</h3>
    <p>{{ copropriete.nomCopropriete }}</p>

    <h3>Questions à voter</h3>
    <ul>
        {% set questionsAVoter = assemblee_generale.questions|filter(q => q.questionAVoter is not null) %}
        {% if questionsAVoter is empty %}
            <li><em>Aucune question à voter</em></li>
        {% else %}
            {% for q in questionsAVoter %}
                <li>{{ q.questionAVoter.contenu }}</li>
            {% endfor %}
        {% endif %}
    </ul>
{% if not assemblee_generale.ouverte %}
    <a href="{{ path('app_question_a_voter_new_for_ag', {id: assemblee_generale.id}) }}" class="btn btn-primary">Ajouter une question à voter</a>
{% endif %}


    <h3>Questions à discuter</h3>
    <ul>
        {% set questionsADiscuter = assemblee_generale.questions|filter(q => q.questionADiscuter is not null) %}
        {% if questionsADiscuter is empty %}
            <li><em>Aucune question à discuter</em></li>
        {% else %}
            {% for q in questionsADiscuter %}
                <li>{{ q.questionADiscuter.contenu }}</li>
            {% endfor %}
        {% endif %}
    </ul>
<a href="{{ path('app_question_a_discuter_new_for_ag', {id: assemblee_generale.id}) }}" class="btn btn-primary">Ajouter une question à discuter</a>


    <h3>Participants</h3>
    <ul>
        {% for p in participations %}
            <li>
                {{ p.participant.nom }} {{ p.participant.prenom }}
                {% if p.present %}
                    – Présent
                {% elseif p.mandataire %}
                    – Représenté par {{ p.mandataire.nom }} {{ p.mandataire.prenom }}
                {% else %}
                    – Absent (procuration)
                {% endif %}
            </li>
        {% else %}
            <li>Aucun participant</li>
        {% endfor %}
    </ul>

    <a href="{{ path('app_participation_add_presence', {id: assemblee_generale.id}) }}">Ajouter une présence</a>

   <h3>Votes</h3>
<ul>
    {% if votes is not empty %}
        {% for vote in votes %}
            <li>
                {{ vote.participation.participant.nom }} {{ vote.participation.participant.prenom }}
                – {{ vote.question.questionAVoter.contenu ?? 'Question non disponible' }}
                – <strong>{{ vote.valeurVote }}</strong>
            </li>
        {% endfor %}
    {% else %}
        <li><em>Aucun vote enregistré</em></li>
    {% endif %}
</ul>
<a href="{{ path('app_vote_list', {id: assemblee_generale.id}) }}" class="btn btn-warning">Supprimer un vote</a>

{% if assemblee_generale.ouverte %}
    <a href="{{ path('app_vote_questions', {'id': assemblee_generale.id}) }}" class="btn btn-primary">Accéder aux votes</a>
{% else %}
    <span class="text-muted">Les votes ne sont accessibles qu’après l’ouverture de l’assemblée.</span>
{% endif %}

<h3>Résultats des votes</h3>
{% for question in questionsAVoter %}
    <h4>{{ question.questionAVoter.contenu }}</h4>
    {% set votesPour = 0 %}
    {% set votesContre = 0 %}
    {% set votesAbstention = 0 %}

    {% for vote in votes %}
        {% if vote.question.questionAVoter == question.questionAVoter %}
            {% if vote.valeurVote == 'Pour' %}
                {% set votesPour = votesPour + 1 %}
            {% elseif vote.valeurVote == 'Contre' %}
                {% set votesContre = votesContre + 1 %}
            {% elseif vote.valeurVote == 'Abstention' %}
                {% set votesAbstention = votesAbstention + 1 %}
            {% endif %}
        {% endif %}
    {% endfor %}

    <ul>
        <li><strong>Pour</strong> : {{ votesPour }}</li>
        <li><strong>Contre</strong> : {{ votesContre }}</li>
        <li><strong>Abstention</strong> : {{ votesAbstention }}</li>
    </ul>
{% else %}
    <p>Aucune question à voter.</p>
{% endfor %}


<a href="{{ path('app_assemblee_generale_index') }}">back to list</a>

<a href="{{ path('app_assemblee_generale_edit', {'id': assemblee_generale.id}) }}">edit</a>

{{ include('assemblee_generale/_delete_form.html.twig') }}
{% endblock %}
