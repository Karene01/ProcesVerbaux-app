{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="fas fa-calendar-plus"></i> Informations de l'assemblée
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- Date -->
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.date, 'Date de l\'assemblée', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.date, {
                        'attr': {
                            'class': 'form-control',
                            'required': 'required'
                        }
                    }) }}
                    {{ form_errors(form.date) }}
                </div>
            </div>

            <!-- Heure -->
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.heure, 'Heure de début', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.heure, {
                        'attr': {
                            'class': 'form-control',
                            'required': 'required'
                        }
                    }) }}
                    {{ form_errors(form.heure) }}
                </div>
            </div>
        </div>

        <!-- Copropriété -->
        <div class="mb-3">
            {{ form_label(form.copropriete, 'Copropriété', {'label_attr': {'class': 'form-label fw-bold'}}) }}
            {{ form_widget(form.copropriete, {
                'attr': {
                    'class': 'form-select',
                    'required': 'required'
                }
            }) }}
            {{ form_errors(form.copropriete) }}
            <div class="form-text">Sélectionnez la copropriété concernée par cette assemblée</div>
        </div>
    </div>
</div>

<!-- Actions -->
<div class="d-flex justify-content-between align-items-center mt-4">
    <a href="{{ path('app_assemblee_generale_index') }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Retour à la liste
    </a>
    <button type="submit" class="btn btn-primary">
        <i class="fas fa-save"></i> {{ button_label|default('Sauvegarder') }}
    </button>
</div>

{{ form_end(form) }}
