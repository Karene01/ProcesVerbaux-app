{% extends 'base.html.twig' %}

{% block title %}AssembleeGenerale index{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 text-primary">
                <i class="fas fa-users"></i> Liste des Assemblées générales
            </h1>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Identifiant</th>
                            <th>Date</th>
                            <th>Heure</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for assemblee_generale in assemblee_generales %}
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark">#{{ assemblee_generale.id }}</span>
                            </td>
                            <td>
                                <i class="fas fa-calendar text-primary"></i>
                                {{ assemblee_generale.date ? assemblee_generale.date|date('d/m/Y') : 'Non définie' }}
                            </td>
                            <td>
                                <i class="fas fa-clock text-primary"></i>
                                {{ assemblee_generale.heure ? assemblee_generale.heure|date('H:i') : 'Non définie' }}
                            </td>
                            <td>
                                {% if assemblee_generale.terminee %}
                                    <span class="badge bg-dark">Terminée</span>
                                {% elseif assemblee_generale.ouverte %}
                                    <span class="badge bg-success">En cours</span>
                                {% else %}
                                    <span class="badge bg-secondary">Non commencée</span>
                                {% endif %}

                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Actions">
                                    <a href="{{ path('app_assemblee_generale_show', {'id': assemblee_generale.id}) }}" 
                                       class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i> Voir plus
                                    </a>
                                    <a href="{{ path('app_assemblee_generale_edit', {'id': assemblee_generale.id}) }}" 
                                       class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                <i class="fas fa-inbox"></i>
                                <em>Aucune assemblée générale trouvée</em>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="{{ path('app_assemblee_generale_new') }}" class="btn btn-outline-primary">
                <i class="fas fa-plus-circle"></i> Ajouter une assemblée générale
            </a>
        </div>
    </div>
{% endblock %}