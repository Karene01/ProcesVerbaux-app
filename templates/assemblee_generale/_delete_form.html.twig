<form method="post" action="{{ path('app_assemblee_generale_delete', {'id': assemblee_generale.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assemblee_generale.id) }}">
    {% if is_granted('ROLE_USER') %}
    <button class="btn">Supprimer</button>
    {% endif %}
</form>
