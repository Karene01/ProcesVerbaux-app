{% extends 'base.html.twig' %}

{% block title %}Question index{% endblock %}

{% block body %}
    <h1>Liste des Question</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Identifant</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for question in questions %}
            <tr>
                <td>{{ question.id }}</td>
                <td>
                    <a href="{{ path('app_question_show', {'id': question.id}) }}">Montrer</a>
                    <a href="{{ path('app_question_edit', {'id': question.id}) }}">Editer</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">Aucune données disponible</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_question_new') }}">Créer une question</a>
{% endblock %}
